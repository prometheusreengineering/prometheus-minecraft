<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>studio.dreamys</groupId>
    <artifactId>prometheus-parent</artifactId>
    <!-- also in every module's <parent>, and modVersion below -->
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <description>The Prometheus' loader for Minecraft.</description>

    <!--
        stage0-legacy: the ModLauncher 2-8 half of the transformation service (see stage0's ModLauncherHook)
        stage0:        the jar users install. JDK only, rarely changes. Downloads and starts the core.
        core:          the loader logic + minecraft-lib. Auto-updated from GitHub releases.
    -->
    <modules>
        <module>core</module>
    </modules>

    <properties>
        <modId>prometheus-minecraft</modId>
        <modVersion>2.0.0</modVersion>

        <!-- -source/-target, not release: the hook APIs we compile against are newer class files than Java 8 -->
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>spongepowered-repo</id>
            <url>https://repo.spongepowered.org/maven/</url>
        </repository>
        <repository>
            <id>minecraftforge</id>
            <url>https://maven.minecraftforge.net/</url>
        </repository>
        <repository>
            <id>neoforged</id>
            <url>https://maven.neoforged.net/releases/</url>
        </repository>
        <repository>
            <id>fabricmc</id>
            <url>https://maven.fabricmc.net/</url>
        </repository>
        <repository>
            <id>glaremasters</id>
            <url>https://repo.glaremasters.me/repository/public/</url>
        </repository>
        <repository>
            <id>carm</id>
            <url>https://repo.carm.cc/repository/maven-public/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <!-- Mixin's jar ships its annotation processor, which crashes javac without Gson. Nothing here has mixins. -->
                        <proc>none</proc>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
